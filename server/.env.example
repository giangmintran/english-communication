PORT=5000
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-optional

# Bật/tắt Edge CDN Cache (true: bật cache, false: tắt hoàn toàn)
ENABLE_CACHE=true

# Telegram Bot Notification (nhận thông báo khi có feedback mới)
# 1. Tạo bot qua @BotFather trên Telegram → lấy token
# 2. Lấy chat_id: gửi tin nhắn cho bot, rồi mở https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
